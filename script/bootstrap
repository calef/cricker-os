#!/bin/sh
# script/bootstrap: resolve every dependency the project needs to build and test.
#
# Part of the "Scripts to Rule Them All" set (see notes/scripts.md). Idempotent: it checks
# for what is already present and installs only what is missing, so it is cheap to re-run and
# safe to call from script/setup, script/update, and script/ci-build.
#
# Name: ratified 2026-07-22 by adopting Scripts to Rule Them All. The canonical set keeps its
# standard names even where a more descriptive word exists, because the entire value is that the
# command is the same in every repository that follows the pattern (notes/naming.md).

set -e
cd "$(dirname "$0")/.."

os="$(uname -s)"

# --- Rust toolchain -----------------------------------------------------------------------
# rust-toolchain.toml pins the channel, its components, and the bare-metal target. We install
# that exact toolchain rather than trusting first-cargo-use to pull the components in.
if ! command -v rustup >/dev/null 2>&1; then
    echo "==> Installing rustup"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
    export PATH="$HOME/.cargo/bin:$PATH"
fi

channel="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
[ -n "$channel" ] || channel="nightly"

echo "==> Ensuring Rust toolchain '$channel' (components + bare-metal targets)"
rustup toolchain install "$channel" --profile minimal
rustup component add --toolchain "$channel" rust-src llvm-tools rustfmt clippy miri
rustup target add --toolchain "$channel" aarch64-unknown-none-softfloat riscv64imac-unknown-none-elf

# --- QEMU ---------------------------------------------------------------------------------
# The kernel runs under qemu-system-aarch64, and the riscv port under qemu-system-riscv64
# (system emulation; see notes/qemu.md). Check for both: a machine provisioned before the
# riscv port has only the first, and `cargo xtask test` now needs the pair.
if command -v qemu-system-aarch64 >/dev/null 2>&1 && command -v qemu-system-riscv64 >/dev/null 2>&1; then
    echo "==> QEMU present: $(qemu-system-aarch64 --version | head -1)"
else
    echo "==> Installing QEMU"
    case "$os" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            echo "bootstrap: Homebrew not found; install it from https://brew.sh, then re-run." >&2
            exit 1
        fi
        # Homebrew's qemu ships every system emulator, riscv64 included.
        brew install qemu
        ;;
    Linux)
        # qemu-system-arm carries qemu-system-aarch64 and qemu-system-misc carries
        # qemu-system-riscv64; ipxe-qemu supplies efi-virtio.rom, the option ROM the
        # -device virtio-blk-device (our disk) loads at startup.
        sudo apt-get update
        sudo apt-get install -y qemu-system-arm qemu-system-misc ipxe-qemu
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install qemu-system-aarch64 by hand." >&2
        exit 1
        ;;
    esac
fi

# ShellCheck, for the 23 `#!/bin/sh` scripts in script/ and scripts/. Worth a dependency because of
# where this project runs: macOS `/bin/sh` is bash in POSIX mode and Ubuntu CI's is dash, so a
# bashism works on a dev machine and fails on a runner. ShellCheck knows the difference and says so.
# The scripts are the gates; a gate that fails silently is worse than no gate. See notes/scripts.md.
if command -v shellcheck >/dev/null 2>&1; then
    echo "==> ShellCheck present: $(shellcheck --version | sed -n 's/^version: //p')"
else
    echo "==> Installing ShellCheck"
    case "$os" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            echo "bootstrap: Homebrew not found; install it from https://brew.sh, then re-run." >&2
            exit 1
        fi
        brew install shellcheck
        ;;
    Linux)
        sudo apt-get update
        sudo apt-get install -y shellcheck
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install shellcheck by hand." >&2
        exit 1
        ;;
    esac
fi

# cargo-machete, for script/lint's unused-dependency gate (§46: a dependency is a decision). Comes
# from cargo rather than a package manager because it is a cargo subcommand and there is no OS
# packaging worth the branch; `--locked` so a fresh install cannot pick up a dependency resolution
# nobody tested.
if command -v cargo-machete >/dev/null 2>&1; then
    echo "==> cargo-machete present"
else
    echo "==> Installing cargo-machete"
    cargo install cargo-machete --locked
fi

# typos, for script/lint's spelling gate over the prose (the documentation is a deliverable here).
# Homebrew calls it `typos-cli` and the binary `typos`, which is the sort of mismatch that wastes an
# afternoon, so both names appear here on purpose.
if command -v typos >/dev/null 2>&1; then
    echo "==> typos present: $(typos --version)"
else
    echo "==> Installing typos"
    case "$os" in
    Darwin)
        brew install typos-cli
        ;;
    Linux)
        # Not in Ubuntu's archive; cargo is the portable route and CI takes it too.
        cargo install typos-cli --locked
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install typos by hand." >&2
        exit 1
        ;;
    esac
fi

# Whichever way QEMU got here, it has to be one this project can actually use. The check is separate
# so it can be re-run any time (a `brew upgrade` months from now is exactly when it matters), and it
# fails only on a MISSING DEVICE; a version that merely differs from the pin is a loud warning, since
# Homebrew cannot install an arbitrary older QEMU and an unfollowable rule is worse than none.
#
# **On Linux this is where `script/setup` used to die with no way forward**, found by milestone 117's
# second stranger run on a stock Ubuntu box. Every Ubuntu release ships a QEMU without
# `riscv-iommu-pci`, so this check hard-fails by design; `set -e` then ended bootstrap here, before
# the clang step, and the remedy it named (`script/ci-qemu`) described itself as "CI only". So the
# reader was told to run a script that told them not to. Nothing was wrong except that nobody had
# started from cold on Linux in weeks.
#
# The fix is to say the whole sequence rather than to reorder: the check must stay ahead of the rest,
# because a bootstrap that installs a compiler and then tells you the emulator is unusable has wasted
# your time in the other direction.
if ! script/qemu-check; then
    if [ "$os" = linux ]; then
        echo >&2
        echo "bootstrap: this is expected on Linux, and it is not the end of the road." >&2
        echo "  No Ubuntu release ships a QEMU new enough for -device riscv-iommu-pci." >&2
        echo "  Build the pinned one, then start over:" >&2
        echo >&2
        echo "      script/ci-qemu     # ~12 minutes, builds and installs the pinned QEMU" >&2
        echo "      script/setup       # picks up where this stopped" >&2
        echo >&2
        echo "  script/ci-qemu is named for CI and is not only for CI; a Linux developer needs" >&2
        echo "  it too, for exactly the reason above." >&2
    fi
    exit 1
fi

# --- A bare-metal C compiler ----------------------------------------------------------------
# Milestone 36 links a C component into the `c_shim` userspace program (user/c/c_seam.c, DECISIONS
# §30), so building `user` now needs a clang with BOTH the AArch64 and RISC-V backends. One
# compiler for both ISAs, not two, because architectural parity is a gate (DECISIONS §19) and two
# clangs would mean "works on aarch64" stopped predicting anything about riscv64.
#
# The check is a capability check, not a `command -v`, because the clang most likely already
# present on a macOS dev machine is Apple's, and Apple's has no RISC-V backend at all. The same
# resolution order lives in user/build.rs, which is what actually runs the compiler; this only
# installs one so that build succeeds. Set CRICKER_CC to point either at something else.
have_cross_clang() {
    for cc in "$CRICKER_CC" /opt/homebrew/opt/llvm/bin/clang /usr/local/opt/llvm/bin/clang clang; do
        [ -n "$cc" ] || continue
        targets="$("$cc" -print-targets 2>/dev/null || true)"
        if echo "$targets" | grep -qE '^ *aarch64 ' && echo "$targets" | grep -qE '^ *riscv64 '; then
            echo "==> Cross clang present: $cc"
            return 0
        fi
    done
    return 1
}

if have_cross_clang; then
    :
else
    echo "==> Installing a clang with the AArch64 and RISC-V backends"
    case "$os" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            echo "bootstrap: Homebrew not found; install it from https://brew.sh, then re-run." >&2
            exit 1
        fi
        # Homebrew's llvm keg ships every LLVM backend. It is deliberately not linked onto PATH
        # (that would shadow Apple's clang), so user/build.rs names the keg path directly.
        brew install llvm
        ;;
    Linux)
        # Debian/Ubuntu build every LLVM backend into their clang packages.
        sudo apt-get update
        sudo apt-get install -y clang
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install a clang whose \`clang -print-targets\` lists" >&2
        echo "           both aarch64 and riscv64, then re-run." >&2
        exit 1
        ;;
    esac
    have_cross_clang || {
        echo "bootstrap: still no clang that can target both aarch64 and riscv64." >&2
        echo "           Set CRICKER_CC=/path/to/clang and re-run." >&2
        exit 1
    }
fi

echo "==> Bootstrap complete"
