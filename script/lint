#!/bin/sh
# script/lint: run clippy across the workspace with warnings denied (the CI clippy gate).
#
# Two invocations, because the workspace has two worlds: the pure-logic host crates and xtask build
# for the host, while kernel and user are bare-metal no_std and only build for the aarch64 target.
# Both use --all-targets so test code is linted too; the kernel supplies its own test harness
# (custom_test_frameworks) and the user bin opts its libtest target out (user/Cargo.toml), which is
# what lets --all-targets work on the bare-metal target. Not one of the canonical scripts, but it
# keeps the CI job a one-liner. It also lints each kernel boot-mode feature (shell/bench/initboot)
# separately, because each compiles different code and a warning can hide in a configuration the
# default build never compiles. See notes/scripts.md.

set -e
cd "$(dirname "$0")/.."

# `user_rt` is excluded from the host pass along with kernel and user: it is the EL0 syscall runtime,
# all aarch64 inline `asm!` (`in("x8")`, ...), so it only compiles for the aarch64 target. On an
# aarch64 host (an Apple Silicon dev machine) it happens to build, but on CI's x86_64 host those
# registers are "unknown register" errors. It is linted with the other bare-metal crates below.
echo "==> clippy: host crates + xtask"
cargo clippy --workspace --exclude kernel --exclude user --exclude user_rt --all-targets -- -D warnings

# The RedoxFS host tool (tools/redoxfs_host) is its own workspace, outside ours on purpose (it wraps
# the vendored engine, which we do not want in our gates; see Cargo.toml). Lint it on its own so our
# code there is still held to -D warnings. The engine it depends on is external to its workspace too,
# so clippy does not lint upstream redoxfs, only our tool.
echo "==> clippy: redoxfs_host (its own workspace)"
cargo clippy --manifest-path tools/redoxfs_host/Cargo.toml --all-targets -- -D warnings

# fs_server is its own workspace too (it wraps the vendored RedoxFS engine, which we keep out of our
# gates). Only the rustdoc pass reached it before milestone 41, so its own code was never clippy'd,
# and there was a real `deref_addrof` sitting in `second_mount` when this line was added. `-D warnings`
# applies to local crates only, so the vendored engine's own warnings do not fail the run.
echo "==> clippy: fs_server (its own workspace)"
cargo clippy --manifest-path fs_server/Cargo.toml --all-targets -- -D warnings

echo "==> clippy: kernel + user + user_rt (aarch64)"
cargo clippy -p kernel -p user -p user_rt --target aarch64-unknown-none-softfloat --all-targets -- -D warnings

# The kernel's boot-mode features (shell, bench, initboot) each compile DIFFERENT code in and out:
# `initboot` and `shell` drop the milestone tour, `bench` diverges before the boot entirely. So a
# warning that only appears in one configuration -- e.g. dead code once the tour is compiled out --
# is invisible to the default run above. Lint each feature build on its own. (A missed initboot
# dead-code warning is exactly why this loop exists.) Bin only: the boot code these features gate
# lives in the binary, not the test target (the boot block is `cfg(not(test))`).
#
# On BOTH ISAs since milestone 41. riscv64 was linted only under `watchdog_probe` before, so the
# whole riscv `shell` boot path (`user::riscv_shell_boot` and the console it builds) was compiled
# by `cargo xtask` and checked by nobody. Parity is a gate, not an aspiration (DECISIONS §19), and
# that applies to the gate itself.
for tgt in aarch64-unknown-none-softfloat riscv64imac-unknown-none-elf; do
    for feat in shell bench initboot; do
        echo "==> clippy: kernel --features $feat ($tgt)"
        cargo clippy -p kernel --features "$feat" --target "$tgt" -- -D warnings
    done
done

# watchdog_probe is the exception to "bin only" above: it gates a TEST (the livelock probe in
# testing.rs), so it is invisible without --all-targets. Linted on both ISAs because an unlinted
# feature rots, and this one is only ever compiled deliberately.
for tgt in aarch64-unknown-none-softfloat riscv64imac-unknown-none-elf; do
    echo "==> clippy: kernel --features watchdog_probe ($tgt)"
    cargo clippy -p kernel --features watchdog_probe --target "$tgt" --all-targets -- -D warnings
done

# No module-wide dead-code suppression, anywhere (milestone 41, DECISIONS §38).
#
# This is a ratchet, and it is the whole reason milestone 41 is not a one-off tidy. Six files used
# to carry `#![allow(dead_code)]` over 5,831 lines, including sched.rs (3,166) and the aarch64 MMU
# (1,275), and main.rs carried a crate-wide one for riscv64 that blindfolded the ENTIRE kernel on
# that ISA. So `-D warnings` reported success over a third of the kernel while nothing was looking,
# which is the same failure as the conflict markers that survived a full gate run below.
#
# An inner attribute (`#![...]`) applies to the whole enclosing module or crate, so one of these can
# never be a decision about a particular item: it is a blanket. A per-item `#[allow(dead_code)]` with
# a stated reason is fine and there are plenty; that is the distinction §38 draws. Bracket-matched
# rather than line-matched because `rustfmt` splits a long `cfg_attr` across lines, and the crate-wide
# riscv one would have been split the moment it grew a second condition.
echo "==> module-wide dead-code suppression"
found=""
for f in $(git ls-files '*.rs' | grep -v '^vendor/' | grep -v '^patches/'); do
    hit=$(awk '
        /^[[:space:]]*#!\[/ { collecting = 1; buf = ""; ln = FNR; opens = 0; closes = 0 }
        collecting {
            buf = buf " " $0
            opens += gsub(/\(/, "(")
            closes += gsub(/\)/, ")")
            if (opens <= closes) {
                if (buf ~ /dead_code|unused/) { gsub(/^[[:space:]]+/, "", buf); print ln ": " buf }
                collecting = 0
            }
        }
    ' "$f")
    [ -n "$hit" ] && found="$found
$f:$hit"
done
if [ -n "$found" ]; then
    echo "lint: module-wide dead-code suppression (an inner attribute blindfolds the whole module):" >&2
    echo "$found" >&2
    echo "" >&2
    echo "Put the allow on the ITEM, with a comment saying which configuration has no caller." >&2
    echo "See DECISIONS.md §38." >&2
    exit 1
fi
echo "module-wide suppression: none"

# No merge conflict markers, anywhere. This is not a style rule, it is a scar: a compositor merge
# resolved only the conflicts visible in a truncated `git merge` summary, and `git add -A` then
# committed DECISIONS.md with its markers intact and pushed them to main. Both sides' prose survived,
# so nothing failed and no test noticed, which is exactly why it needs a gate: broken markup in a
# documentation deliverable is invisible to every other check we run. Costs a grep.
echo "==> conflict markers"
if git grep -nE '^(<{7}|={7}|>{7})( |$)' -- \
    ':!vendor' ':!*.lock' > /tmp/cricker-conflict-markers.txt 2>/dev/null; then
    echo "lint: merge conflict markers left in tracked files:" >&2
    cat /tmp/cricker-conflict-markers.txt >&2
    exit 1
fi

# The milestone table's status column, validated (see design/roadmap.md's status vocabulary and
# script/roadmap). Catches a status token nobody defined, a detail block with no table row, and a
# milestone referenced in prose that the table does not carry, which is exactly how milestone 34 went
# missing. Documentation is part of this project's deliverable, so its index gets a gate.
echo "==> roadmap status"
"$(dirname "$0")/roadmap" --check

# Intra-doc links, denied when broken. This codebase leans unusually hard on `[`Item`]` links to
# stitch the code to itself and to the notes, which is deliberate (see CLAUDE.md on commenting) and
# makes a broken link a real loss rather than cosmetic. Nothing checked them until 2026-07-30, and
# there were TEN, including a whole crate's worth in `abi` where nested modules linked crate-root
# items without a path, plus `name[24]` in a comment that markdown read as a link.
#
# Split three ways because the workspace is not one target: the bare crates document for aarch64
# (riscv64 would refuse `xtask`, which needs std), `xtask` is a host tool, and fs_server is its own
# workspace.
echo "==> rustdoc (broken intra-doc links)"
DOCFLAGS="-D rustdoc::broken_intra_doc_links -D rustdoc::invalid_html_tags"
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet --workspace --exclude xtask \
    --target aarch64-unknown-none-softfloat
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet -p xtask
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet --manifest-path fs_server/Cargo.toml --lib

# DECISIONS.md's numbering, and that every §N cited in the tree resolves. Two concurrent milestones
# both claimed §30 on 2026-07-30 and it was caught only because an agent noticed; 418 code comments
# cite a section by number, so a dangling citation is a broken footnote in the one place this project
# asks a reader to trust prose. See script/decisions.
echo "==> decisions"
"$(dirname "$0")/decisions" --check

# The script/ front door is documented in exactly one comprehensive place, and the README's list is a
# deliberate SUBSET of it. Two checks, because they fail in opposite directions: a script nobody
# documented is invisible, and a README naming a script that no longer exists sends a new reader into
# a wall. notes/scripts.md was missing five entries when this check was written, none of them noticed.
echo "==> script docs"
missing=""
for f in "$(dirname "$0")"/*; do
    name="$(basename "$f")"
    # Match the name followed by a non-name character, not a closing backtick: entries carry usage
    # (`script/toolchain-bump [YYYY-MM-DD]`), and requiring the backtick missed one on the first run.
    grep -qE "script/$name([^a-z-]|\$)" "$(dirname "$0")/../notes/scripts.md" || missing="$missing $name"
done
if [ -n "$missing" ]; then
    echo "lint: scripts with no entry in notes/scripts.md:$missing" >&2
    exit 1
fi
for name in $(grep -oE "script/[a-z-]+" "$(dirname "$0")/../README.md" | sort -u | cut -d/ -f2); do
    [ -e "$(dirname "$0")/$name" ] || { echo "lint: README names script/$name, which does not exist" >&2; exit 1; }
done
echo "script docs: every script documented, every README reference resolves"

# The naming conventions, for the ones a machine can check (milestone 46, DECISIONS §39). The rest of
# them -- "name a component for what it is", "prefer a word a reader can parse without prior Unix
# exposure" -- need judgement and stay prose, in notes/naming.md. These four do not.
#
# Every check below is a ratchet, and the argument is §39's: a name is a claim, made before a reader
# sees a line of code. `netd`, `compd`, `gpud` and `termd` each claimed a Unix daemon model this OS
# does not have, and the claim survived four milestones because nothing was looking. Cheap greps,
# because lint runs constantly.
echo "==> naming conventions"

# 1. No `-d` suffix on a component or a crate. §39 made this a rule; without a check it lasts until
#    the first inconvenient moment. Three characters or fewer is not a daemon name, it is an
#    abbreviation (`kbd` is the keyboard driver), so the rule starts at four. Names that genuinely
#    end in `d` go in the allow-list WITH a reason, the same shape as a per-item `#[allow]`.
#
#    Allowed: `asid` is Address Space IDentifier, the aarch64/RISC-V hardware term (notes/asids.md).
#    Allowed: `cred` is the abbreviation of "credential", the same shortening `kbd` is of "keyboard".
#    The thing it names is a store and a verifier, not a long-running process; the long-running
#    process that holds one is spelled out in full, as `credentialer` (notes/credentials.md).
naming_allow=" asid cred "
named_for_a_daemon=""
for name in \
    $(ls "$(dirname "$0")/../user/src" | sed 's/\.rs$//') \
    $(grep -A1 '^\[\[bin\]\]' "$(dirname "$0")/../user/Cargo.toml" | sed -n 's/^name = "\(.*\)"$/\1/p') \
    $(ls "$(dirname "$0")/../crates")
do
    case "$name" in
        ???*d)
            case "$naming_allow" in
                *" $name "*) ;;
                *) named_for_a_daemon="$named_for_a_daemon $name" ;;
            esac
            ;;
    esac
done
if [ -n "$named_for_a_daemon" ]; then
    echo "lint: names ending in -d, which claims a daemon this OS does not have:$named_for_a_daemon" >&2
    echo "Name it for what it is (DECISIONS §39, notes/naming.md). If the word simply ends in d," >&2
    echo "add it to naming_allow in this script with the reason." >&2
    exit 1
fi

# 2. "Daemon" appears nowhere. §39's vocabulary is component / service / contract, and the word is
#    excluded from code, comments and notes. Three files are exempt because they are where the
#    ARGUMENT about the word lives: DECISIONS.md, design/, and notes/naming.md. A rule's rationale
#    has to be able to name the thing it rejects, and this script does too.
if git -C "$(dirname "$0")/.." grep -Iilnw daemon -- \
    ':!vendor' ':!DECISIONS.md' ':!design' ':!notes/naming.md' ':!script/lint' \
    > /tmp/cricker-daemon.txt 2>/dev/null; then
    echo "lint: \"daemon\" outside the three places the argument about the word lives:" >&2
    cat /tmp/cricker-daemon.txt >&2
    echo "The vocabulary is component / service / contract (DECISIONS §39)." >&2
    exit 1
fi

# 3. One spelling for contract crates. The tree had four spellings of "the wire contract" when this
#    was written (`fs_proto`, `gfx_proto`, `netproto`, `line_editor::proto`); `*_proto` wins for CRATES
#    because it is what both of them already were, and a second habit is how the first one rots.
for dir in "$(dirname "$0")"/../crates/*proto; do
    name="$(basename "$dir")"
    case "$name" in
        *_proto) ;;
        *) echo "lint: contract crate $name should be spelled *_proto (notes/naming.md)" >&2; exit 1 ;;
    esac
done

# 4. Branch prefixes from a fixed set, which is what retires the `feat/` versus `feature/` duplicate
#    the survey found. Current branch only, because that is the one a developer can still rename; a
#    detached HEAD (every CI pull_request run, since actions/checkout builds the merge commit) has no
#    branch to judge and is skipped rather than guessed at.
branch="$(git -C "$(dirname "$0")/.." symbolic-ref --quiet --short HEAD || true)"
case "$branch" in
    # No branch (detached HEAD), or the trunk.
    ""|main) ;;
    # The tooling's own worktree branches, which no person types.
    worktree-agent-*) ;;
    milestone/*|fix/*|bench/*|audit/*|integration/*|finalize/*|feature/*) ;;
    *)
        echo "lint: branch '$branch' has no recognised prefix." >&2
        echo "Use milestone/, fix/, bench/, audit/, integration/, finalize/ or feature/." >&2
        echo "Not feat/: one spelling, and feature/ is the older one (notes/naming.md)." >&2
        exit 1
        ;;
esac
# 5. **No `#[path]` module shared by two or more binaries** (CLAUDE.md rule 7, 2026-08-01).
#    Anything two binaries must agree on is a crate; a `#[path]` module is not one, and the cost is
#    not tidiness. Such a module is unreachable by host tests AND by Kani, so the constants two
#    programs share are checked by nothing. `cseam` was the proof: it stated the shared-memory
#    layout twice, once in Rust and once in `user/c/c_seam.c`, with no test that they agreed, and a
#    drift would have surfaced as a C component writing to the wrong offset.
#
#    A module with exactly ONE consumer is fine and stays fine: that is an ordinary submodule, and
#    the rule is about agreement between binaries, not about file layout. `net_transport` and
#    `socket_test_client` are that case today.
#
#    This check is the one that would have caught the whole class. It counts consumers per include
#    target, so it fails the moment a second binary reaches for the same file.
#    The allow-list is empty, and that is the intended steady state. `virtio` was the one
#    entry: it could not be a crate while it reached back into whichever binary included it
#    for `check`, and the fix was to delete `check` rather than to pass it in. Rust already
#    has the per-binary "how this program dies" hook, `#[panic_handler]`, and both binaries
#    already had one doing the same thing. An entry here needs that kind of reason.
path_module_allow=" "
shared_modules=""
for target in $(grep -rhoE '#\[path = "[a-z_0-9]+\.rs"\]' "$(dirname "$0")/../user/src" 2>/dev/null |
                sed 's/.*"\(.*\)\.rs".*/\1/' | sort -u); do
    consumers=$(grep -rlE "^mod $target;" "$(dirname "$0")/../user/src" 2>/dev/null | wc -l | tr -d ' ')
    if [ "$consumers" -gt 1 ]; then
        case "$path_module_allow" in
            *" $target "*) ;;
            *) shared_modules="$shared_modules $target($consumers)" ;;
        esac
    fi
done
if [ -n "$shared_modules" ]; then
    echo "lint: #[path] modules shared by more than one binary:$shared_modules" >&2
    echo "" >&2
    echo "CLAUDE.md rule 7: anything two binaries must agree on is a crate, never a #[path]" >&2
    echo "module. A shared module is invisible to host tests and to Kani, so what two programs" >&2
    echo "agree on ends up checked by nothing. Move it to crates/ and depend on it." >&2
    echo "A module with a single consumer is fine; this only fires at two or more." >&2
    exit 1
fi

# 6. **`notes/` and `design/` markdown filenames are lowercase and hyphenated** (CLAUDE.md).
#    They are URL slugs the moment any of this is published, and a hyphen is a word separator in a
#    URL where an underscore is a joiner. It is also the convention every documentation tree uses
#    (the Rust Book, Linux Documentation/, the Kubernetes site), which is the whole argument: a
#    reader already knows the shape.
#
#    README.md is the exception and the only one: GitHub renders it as the directory index, which is
#    behaviour rather than style, and the same reason repo-root files are SCREAMING_SNAKE_CASE.
doc_name_bad=""
for f in "$(dirname "$0")"/../notes/*.md "$(dirname "$0")"/../design/*.md; do
    base="$(basename "$f")"
    [ "$base" = "README.md" ] && continue
    case "$base" in
        # `[[:upper:]]`, not `[A-Z]`: in most locales a glob range interleaves cases, so
        # `[A-Z]` matches lowercase too and this check flagged every file in the tree.
        *_*|*[[:upper:]]*) doc_name_bad="$doc_name_bad $base" ;;
    esac
done
if [ -n "$doc_name_bad" ]; then
    echo "lint: notes/ and design/ filenames must be lowercase and hyphenated:$doc_name_bad" >&2
    echo "" >&2
    echo "These become URL slugs. A hyphen separates words in a URL; an underscore joins them." >&2
    echo "README.md is the only exception, because GitHub renders it as the directory index." >&2
    exit 1
fi

echo "naming: no -d names, no daemons, contract crates spelled one way, branch prefix recognised,"
echo "        no #[path] module shared by two binaries, docs lowercase and hyphenated"

echo "==> markdown links and the notes index"
# Two checks, and deliberately NOT a markdown linter. A survey of all 95 markdown files found zero
# broken relative links and exactly one unindexed note, so generic style rules (heading case, line
# length, list markers) would fire constantly on prose that is deliberate and catch nothing. These
# two are the parts that rot silently:
#
# 1. Relative links must resolve. Currently clean, so this is a REGRESSION GUARD: milestone 46 moved
#    five things and could easily have broken a link, and the next rename might.
# 2. Every notes/*.md must appear in notes/README.md, which CLAUDE.md requires and which had already
#    drifted (notes/session-handoff.md).
#
# Backticked repo paths are deliberately NOT checked. The same survey found 8 that do not resolve and
# all 8 are correct: `crates/linedisc` is preserved on purpose in DECISIONS §39 and the milestone 46
# block, and `crates/heap`/`crates/slab`/`kernel/src/heap.rs` are accurate prose about what milestone
# 14 removed. A checker there is 100% false positives, and history we deliberately keep is not rot.
python3 - <<'PY'
import glob, os, re, sys

md = [f for f in glob.glob('**/*.md', recursive=True)
      if not f.startswith(('vendor/', 'target/', '.claude/', 'patches/'))]

bad = []
for f in md:
    base = os.path.dirname(f)
    for m in re.finditer(r'\[[^\]]*\]\(([^)]+)\)', open(f, errors='replace').read()):
        target = m.group(1).split('#')[0].strip()
        if not target or target.startswith(('http://', 'https://', 'mailto:')):
            continue
        if not os.path.exists(os.path.normpath(os.path.join(base, target))):
            bad.append(f'{f} -> {target}')

index = open('notes/README.md', errors='replace').read()
missing = [n for n in sorted(glob.glob('notes/*.md'))
           if os.path.basename(n) != 'README.md' and os.path.basename(n) not in index]

if bad:
    print('lint: broken relative markdown links:', file=sys.stderr)
    for b in bad:
        print(f'  {b}', file=sys.stderr)
if missing:
    print('lint: notes/ files missing from notes/README.md:', file=sys.stderr)
    for m in missing:
        print(f'  {m}', file=sys.stderr)
    print('Every note is indexed there (CLAUDE.md); an unindexed note is one nobody finds.',
          file=sys.stderr)
if bad or missing:
    sys.exit(1)
print(f'markdown: {len(md)} files, every relative link resolves, every note indexed')
PY

echo "==> em-dashes"
# Chris's standing style rule (CLAUDE.md): no em-dashes, use commas, periods, semicolons or
# parentheses. It is a house style rather than a correctness property, and it is gated for the same
# reason the roadmap's status vocabulary is: a rule nobody checks is a rule that decays. 419 of them
# had accumulated across 75 files by 2026-08-01 despite being written down from the start, because
# every individual one looked fine in the moment it was typed.
#
# Vendored trees are exempt: they are somebody else's prose and must stay byte-identical to the pin.
# The character is built from its UTF-8 bytes rather than written literally, because a checker that
# contains the thing it forbids flags itself. That is not a cute trick, it is the only way this gate
# can be self-consistent without an exemption, and an exemption would be a hole someone later widens.
emdash="$(printf '\342\200\224')"
if git ls-files | grep -v '^vendor/' | grep -v '^patches/' | xargs grep -l "$emdash" 2>/dev/null | grep -q .; then
    echo "lint: em-dashes found (CLAUDE.md: use commas, periods, semicolons or parentheses):" >&2
    git ls-files | grep -v '^vendor/' | grep -v '^patches/' | xargs grep -n "$emdash" 2>/dev/null | sed 's/^/  /' >&2
    exit 1
fi
echo "em-dashes: none outside vendored trees"

echo "==> shellcheck"
# The 23 `#!/bin/sh` scripts, gated at warning severity. Two reasons this earns a dependency here
# rather than being generic hygiene:
#
# 1. **macOS dev, Ubuntu CI.** `/bin/sh` is bash-in-POSIX-mode on one and dash on the other, so a
#    bashism runs fine locally and fails on a runner. ShellCheck knows POSIX sh from bash and says
#    which is which. We currently have zero such findings, which is exactly the property that
#    regresses silently.
# 2. **These scripts ARE the gates.** script/fmt shipped for months accepting `--check` and silently
#    ignoring it, and unformatted code reached main behind a clean report. A gate that fails open is
#    worse than no gate, and shell is where failing open is easiest.
#
# Severity is `warning`, not `note`, and that is a deliberate scope rather than laziness (DECISIONS
# §38: a suppression is scoped and carries a reason). The tree has ZERO errors and ZERO warnings, so
# this is green today and is a regression guard. The 13 note-level findings are all SC2086 in the
# QEMU runners' argument assembly, where `$INITRD`/`$DISK`/`$NET`/`$GPU`/`$KBD`/`$MON` are unquoted
# ON PURPOSE: each holds a multi-word QEMU fragment, and quoting would pass it as one argument and
# break the emulator. Raising to note level means restructuring that assembly with `set --` (the
# pattern script/fmt uses) rather than blanket-disabling the rule, and that is a change to the script
# every test run depends on, so it is not worth bundling here.
if ! command -v shellcheck >/dev/null 2>&1; then
    echo "lint: shellcheck not found; run script/bootstrap (it installs it)." >&2
    exit 1
fi
cd "$(dirname "$0")/.."
shellcheck --severity=warning script/* scripts/*.sh
# Counted, not remembered. This line read "23 sh scripts" as a literal, so it kept saying 23 after a
# 24th was added -- harmless here because the glob above is what actually checks them, but it is the
# same defect as script/fmt's: a gate reporting a number it did not measure. Anything that looks like
# evidence has to be derived from the thing it describes.
echo "shellcheck: $(ls script/* scripts/*.sh | wc -l | tr -d ' ') sh scripts, no errors or warnings"
