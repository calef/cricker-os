#!/bin/sh
# script/lint: run clippy across the workspace with warnings denied (the CI clippy gate).
#
# Two invocations, because the workspace has two worlds: the pure-logic host crates and xtask build
# for the host, while kernel and user are bare-metal no_std and only build for the aarch64 target.
# Both use --all-targets so test code is linted too; the kernel supplies its own test harness
# (custom_test_frameworks) and the user bin opts its libtest target out (user/Cargo.toml), which is
# what lets --all-targets work on the bare-metal target. Not one of the canonical scripts, but it
# keeps the CI job a one-liner. It also lints each kernel boot-mode feature (shell/bench/initboot)
# separately, because each compiles different code and a warning can hide in a configuration the
# default build never compiles. See notes/scripts.md.

set -e
cd "$(dirname "$0")/.."

# `user_rt` is excluded from the host pass along with kernel and user: it is the EL0 syscall runtime,
# all aarch64 inline `asm!` (`in("x8")`, ...), so it only compiles for the aarch64 target. On an
# aarch64 host (an Apple Silicon dev machine) it happens to build, but on CI's x86_64 host those
# registers are "unknown register" errors. It is linted with the other bare-metal crates below.
echo "==> clippy: host crates + xtask"
cargo clippy --workspace --exclude kernel --exclude user --exclude user_rt --all-targets -- -D warnings

# The RedoxFS host tool (tools/redoxfs-host) is its own workspace, outside ours on purpose (it wraps
# the vendored engine, which we do not want in our gates; see Cargo.toml). Lint it on its own so our
# code there is still held to -D warnings. The engine it depends on is external to its workspace too,
# so clippy does not lint upstream redoxfs, only our tool.
echo "==> clippy: redoxfs-host (its own workspace)"
cargo clippy --manifest-path tools/redoxfs-host/Cargo.toml --all-targets -- -D warnings

echo "==> clippy: kernel + user + user_rt (aarch64)"
cargo clippy -p kernel -p user -p user_rt --target aarch64-unknown-none-softfloat --all-targets -- -D warnings

# The kernel's boot-mode features (shell, bench, initboot) each compile DIFFERENT code in and out:
# `initboot` and `shell` drop the milestone tour, `bench` diverges before the boot entirely. So a
# warning that only appears in one configuration -- e.g. dead code once the tour is compiled out --
# is invisible to the default run above. Lint each feature build on its own. (A missed initboot
# dead-code warning is exactly why this loop exists.) Bin only: the boot code these features gate
# lives in the binary, not the test target (the boot block is `cfg(not(test))`).
for feat in shell bench initboot; do
    echo "==> clippy: kernel --features $feat (aarch64)"
    cargo clippy -p kernel --features "$feat" --target aarch64-unknown-none-softfloat -- -D warnings
done

# watchdog_probe is the exception to "bin only" above: it gates a TEST (the livelock probe in
# testing.rs), so it is invisible without --all-targets. Linted on both ISAs because an unlinted
# feature rots, and this one is only ever compiled deliberately.
for tgt in aarch64-unknown-none-softfloat riscv64imac-unknown-none-elf; do
    echo "==> clippy: kernel --features watchdog_probe ($tgt)"
    cargo clippy -p kernel --features watchdog_probe --target "$tgt" --all-targets -- -D warnings
done

# No merge conflict markers, anywhere. This is not a style rule, it is a scar: a compositor merge
# resolved only the conflicts visible in a truncated `git merge` summary, and `git add -A` then
# committed DECISIONS.md with its markers intact and pushed them to main. Both sides' prose survived,
# so nothing failed and no test noticed, which is exactly why it needs a gate: broken markup in a
# documentation deliverable is invisible to every other check we run. Costs a grep.
echo "==> conflict markers"
if git grep -nE '^(<{7}|={7}|>{7})( |$)' -- \
    ':!vendor' ':!*.lock' > /tmp/cricker-conflict-markers.txt 2>/dev/null; then
    echo "lint: merge conflict markers left in tracked files:" >&2
    cat /tmp/cricker-conflict-markers.txt >&2
    exit 1
fi

# The milestone table's status column, validated (see design/roadmap.md's status vocabulary and
# script/roadmap). Catches a status token nobody defined, a detail block with no table row, and a
# milestone referenced in prose that the table does not carry, which is exactly how milestone 34 went
# missing. Documentation is part of this project's deliverable, so its index gets a gate.
echo "==> roadmap status"
"$(dirname "$0")/roadmap" --check

# Intra-doc links, denied when broken. This codebase leans unusually hard on `[`Item`]` links to
# stitch the code to itself and to the notes, which is deliberate (see CLAUDE.md on commenting) and
# makes a broken link a real loss rather than cosmetic. Nothing checked them until 2026-07-30, and
# there were TEN, including a whole crate's worth in `abi` where nested modules linked crate-root
# items without a path, plus `name[24]` in a comment that markdown read as a link.
#
# Split three ways because the workspace is not one target: the bare crates document for aarch64
# (riscv64 would refuse `xtask`, which needs std), `xtask` is a host tool, and fs-server is its own
# workspace.
echo "==> rustdoc (broken intra-doc links)"
DOCFLAGS="-D rustdoc::broken_intra_doc_links -D rustdoc::invalid_html_tags"
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet --workspace --exclude xtask \
    --target aarch64-unknown-none-softfloat
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet -p xtask
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet --manifest-path fs-server/Cargo.toml --lib

# DECISIONS.md's numbering, and that every §N cited in the tree resolves. Two concurrent milestones
# both claimed §30 on 2026-07-30 and it was caught only because an agent noticed; 418 code comments
# cite a section by number, so a dangling citation is a broken footnote in the one place this project
# asks a reader to trust prose. See script/decisions.
echo "==> decisions"
"$(dirname "$0")/decisions" --check

# The script/ front door is documented in exactly one comprehensive place, and the README's list is a
# deliberate SUBSET of it. Two checks, because they fail in opposite directions: a script nobody
# documented is invisible, and a README naming a script that no longer exists sends a new reader into
# a wall. notes/scripts.md was missing five entries when this check was written, none of them noticed.
echo "==> script docs"
missing=""
for f in "$(dirname "$0")"/*; do
    name="$(basename "$f")"
    # Match the name followed by a non-name character, not a closing backtick: entries carry usage
    # (`script/toolchain-bump [YYYY-MM-DD]`), and requiring the backtick missed one on the first run.
    grep -qE "script/$name([^a-z-]|\$)" "$(dirname "$0")/../notes/scripts.md" || missing="$missing $name"
done
if [ -n "$missing" ]; then
    echo "lint: scripts with no entry in notes/scripts.md:$missing" >&2
    exit 1
fi
for name in $(grep -oE "script/[a-z-]+" "$(dirname "$0")/../README.md" | sort -u | cut -d/ -f2); do
    [ -e "$(dirname "$0")/$name" ] || { echo "lint: README names script/$name, which does not exist" >&2; exit 1; }
done
echo "script docs: every script documented, every README reference resolves"
