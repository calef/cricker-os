#!/bin/sh
# script/fmt: format the tree with the pinned rustfmt. `--check` instead reports whether it is
# already formatted, changes nothing, and exits non-zero if not; that is the form the CI gate and
# script/toolchain-bump use. Not one of the canonical "Scripts to Rule Them All", but it keeps the
# CI job a one-liner. See notes/scripts.md.
#
# It used to be a checker that never wrote anything, while being named for the thing it did not do.
# That cost real time: a genuine failure was misread as a bad flag, the checker was re-run, produced
# no diff (checkers do not), and unformatted code rode onto main behind a "clean" report. DECISIONS
# §39 is the general rule this is an instance of: a name is a claim.
#
# Unknown arguments are a hard error rather than ignored, which is the other half of the same
# incident: the old script accepted `--check` and silently disregarded it, so what it did could not
# be inferred from how it was invoked.
#
# Name: recorded (the paragraph above, which cites DECISIONS §39). This is the one entry point in
# the directory whose name was itself the fix: it was a checker named for the thing it did not do,
# unformatted code rode onto main behind a clean report, and the correction was to make the
# behaviour match the word. That is a naming argument on the record. What it settles is why this is
# not called after checking; it does not weigh `fmt` against `format`, which takes `cargo fmt`'s
# spelling, the guard rail one layer out. Introduced 2026-07-22 with the Scripts to Rule Them All
# adoption, though **not** one of the canonical names (`bootstrap`, `setup`, `update`, `server`,
# `test`, `cibuild`, `console`). calef has not ruled on it.

set -e
cd "$(dirname "$0")/.."

case "$1" in
    --check) set -- --check ;;
    "") set -- ;;
    *)
        echo "script/fmt: unknown argument '$1' (expected --check, or nothing to format)" >&2
        exit 2
        ;;
esac

cargo fmt --all "$@"

# The RedoxFS host tool is its own workspace (see Cargo.toml), so `--all` above does not reach it.
# Handle our code there separately. The vendored engine it wraps is external and is never touched by
# this (we keep it byte-identical to the pin).
cargo fmt --manifest-path tools/redoxfs_host/Cargo.toml "$@"

# fs_server is a third workspace, for the same reason, and it was missed when this script was fixed
# on 2026-07-31: `--all` does not cross a workspace boundary, and naming one of the two outliers
# looks exactly like naming both. Milestone 57's lane found it by running `cargo fmt` there by hand
# and getting three unformatted lines in `fs_server.rs` that had been sitting in a CI-gated tree.
#
# The general lesson is the one script/fmt already carries a scar for: this file is a GATE, so a
# thing it does not reach is a thing nothing reaches.
cargo fmt --manifest-path fs_server/Cargo.toml "$@"

# And the fuzz workspace (milestone 42), a fourth for the same reason. Formatting builds nothing, so
# this costs a rustfmt pass over four small files and closes the hole before it opens: the lesson
# above is that a gate does not reach across a workspace boundary, and this is a new boundary.
cargo fmt --manifest-path fuzz/Cargo.toml "$@"

# `std_exerciser` is a fifth, and finding it unformatted is the third time this exact lesson has been
# learned in this file. It has been its own workspace since milestone 27 and this gate has never
# reached it, so the file it holds had a rustfmt diff sitting in a CI-green tree, exactly as
# `fs_server` did. Nothing about `std_exerciser` needs the `nife-dev` toolchain to be *formatted*:
# rustfmt parses, it does not build, so no target spec and no build-std are involved.
cargo fmt --manifest-path std_exerciser/Cargo.toml "$@"

# And `entropy_backend` (milestone 64), a sixth, for the same reason and with no caveat. It sat under
# `patches/` until 2026-08-18, which needed a paragraph here explaining why this gate reached into a
# directory `script/lint` excludes wholesale. It no longer does: `patches/` is for patches carried
# against upstream projects (its own README says so) and this crate changes nothing of `getrandom`'s.
# It is ours, its own workspace, beside `std_exerciser`, and the disagreement it used to require an
# explanation for is gone.
cargo fmt --manifest-path entropy_backend/Cargo.toml "$@"
