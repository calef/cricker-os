#!/bin/sh
# script/setup: get the project ready to use from a fresh clone (or a clean slate).
#
# Installs dependencies, then builds so the first run is warm. After this, script/test,
# script/server, and script/console all work. See notes/scripts.md.

set -e
cd "$(dirname "$0")/.."

script/bootstrap

# There is deliberately no `rustup update` here. rust-toolchain.toml pins a DATED nightly
# (`nightly-2026-07-26` as of writing), and script/bootstrap above installs exactly that channel with
# its components, so there is nothing for setup to advance. Bumping the pin is a deliberate act with
# its own tool, `script/toolchain-bump`, which raises the date, rebuilds the std farm clean, runs the
# gates and restores the old pin if they fail.
#
# This block used to run `rustup update nightly`, with a comment claiming the project rode the
# floating channel on purpose. That stopped being true on 2026-07-30, when the pin was dated to fix a
# CI break, and the stale version was worse than merely wrong: it downloaded and advanced a toolchain
# the build never uses, so its cost was real and its effect was nil. See notes/scripts.md and the
# rationale at the top of rust-toolchain.toml.

echo "==> Building the kernel, the user program, and the disk image"
cargo xtask build

echo "==> Setup complete. Next: script/test, script/server, or script/console"
