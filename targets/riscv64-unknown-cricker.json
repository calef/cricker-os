{
  "arch": "riscv64",
  "code-model": "medium",
  "cpu": "generic-rv64",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "",
  "executables": true,
  "features": "+m,+a,+c",
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-abiname": "lp64",
  "llvm-target": "riscv64",
  "max-atomic-width": 64,
  "metadata": {
    "description": "cricker-os userspace, riscv64 (rv64imac U-mode, native capability ABI)",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "os": "cricker",
  "panic-strategy": "abort",
  "relocation-model": "static",
  "singlethread": true,
  "target-pointer-width": 64
}
