From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Alef <chris@crickertech.com>
Date: Mon, 3 Aug 2026 12:00:00 -0700
Subject: [PATCH] Let a no_std caller create a filesystem by supplying the uuid

FileSystem::create and create_reserved are #[cfg(feature = "std")], and reading
why shows the gate is wider than the reason for it. Everything they do builds
for no_std except one call: Header::new stamps a fresh v4 uuid, which is
getrandom, which is std. An engine with no source of randomness cannot invent a
disk id, so the constructor is std-only and the whole creation path went with
it.

The library already solves this exact problem one line away. create takes ctime
and ctime_nsec as parameters precisely because a no_std engine has no clock. Do
the same for randomness: Header::new_with_uuid(size, uuid) and
FileSystem::create_reserved_with_uuid(.., uuid) take the value from the caller,
and the std entry points keep their signatures and pass Uuid::new_v4(). No
existing caller changes.

The encryption branch stays behind std, because Salt::new and Key::new are
getrandom too. A no_std create with a password returns ENOSYS rather than
silently making an unencrypted filesystem, which would withhold the one
property the caller asked for.

This is what a bare-metal target needs to run mkfs at all: on such a system the
randomness comes from a device or a service the caller holds, never from the
filesystem library.

Verified: cargo build --no-default-features for
aarch64-unknown-none-softfloat and riscv64imac-unknown-none-elf, and the
existing library test suite (39 tests) passes with --features std.
---
 src/filesystem.rs | 43 +++++++++++++++++++++++++++++++++++++------
 src/header.rs     |  9 ++++++++-
 2 files changed, 47 insertions(+), 5 deletions(-)

diff --git a/src/filesystem.rs b/src/filesystem.rs
--- a/src/filesystem.rs
+++ b/src/filesystem.rs
@@ -6,11 +6,13 @@
 use syscall::error::{Error, Result, EKEYREJECTED, ENOENT, ENOKEY};
 use xts_mode::{get_tweak_default, Xts128};
 
+// Only the encryption branch of `create_reserved` still needs std: it mints a salt and two
+// keys from getrandom. Everything else the creation path uses builds for no_std.
 #[cfg(feature = "std")]
-use crate::{AllocEntry, AllocList, BlockData, BlockTrait, Key, KeySlot, Node, Salt, TreeList};
+use crate::{Key, KeySlot, Salt};
 use crate::{
-    Allocator, BlockAddr, BlockLevel, BlockMeta, Disk, Header, Transaction, BLOCK_SIZE,
-    HEADER_RING, RECORD_SIZE,
+    AllocEntry, AllocList, Allocator, BlockAddr, BlockData, BlockLevel, BlockMeta, BlockTrait, Disk,
+    Header, Node, Transaction, TreeList, BLOCK_SIZE, HEADER_RING, RECORD_SIZE,
 };
 
 fn compress_cache() -> Vec<u8> {
@@ -125,11 +127,37 @@
     /// We need to pass ctime and ctime_nsec in order to initialize the unix timestamps
     #[cfg(feature = "std")]
     pub fn create_reserved(
+        disk: D,
+        password_opt: Option<&[u8]>,
+        reserved: &[u8],
+        ctime: u64,
+        ctime_nsec: u32,
+    ) -> Result<Self> {
+        let uuid = uuid::Uuid::new_v4();
+        Self::create_reserved_with_uuid(
+            disk,
+            password_opt,
+            reserved,
+            ctime,
+            ctime_nsec,
+            *uuid.as_bytes(),
+        )
+    }
+
+    /// Create a file system on a disk, with reserved data at the beginning, taking the
+    /// filesystem's unique id from the caller.
+    ///
+    /// This is `create_reserved` with the values a no_std engine cannot invent taken as
+    /// arguments. `ctime`/`ctime_nsec` are already such arguments, because the engine has no
+    /// clock; `uuid` joins them, because it has no source of randomness either. A caller that
+    /// holds one can then create a filesystem without std.
+    pub fn create_reserved_with_uuid(
         mut disk: D,
         password_opt: Option<&[u8]>,
         reserved: &[u8],
         ctime: u64,
         ctime_nsec: u32,
+        uuid: [u8; 16],
     ) -> Result<Self> {
         let disk_size = disk.size()?;
         let disk_blocks = disk_size / BLOCK_SIZE;
@@ -154,9 +182,11 @@
             }
         }
 
-        let mut header = Header::new(fs_blocks * BLOCK_SIZE);
+        #[allow(unused_mut)] // only the encryption branch below writes to it
+        let mut header = Header::new_with_uuid(fs_blocks * BLOCK_SIZE, uuid);
 
         let cipher_opt = match password_opt {
+            #[cfg(feature = "std")]
             Some(password) => {
                 //TODO: handle errors
                 header.key_slots[0] = KeySlot::new(
@@ -167,6 +197,12 @@
                 .unwrap();
                 Some(header.key_slots[0].cipher(password).unwrap())
             }
+            // A no_std build has no getrandom, so it cannot mint the salt and the two keys an
+            // encrypted filesystem needs. Refusing is the honest answer: creating an
+            // UNENCRYPTED filesystem for a caller who supplied a password would silently
+            // withhold the one property they asked for.
+            #[cfg(not(feature = "std"))]
+            Some(_) => return Err(Error::new(syscall::error::ENOSYS)),
             None => None,
         };
 
diff --git a/src/header.rs b/src/header.rs
--- a/src/header.rs
+++ b/src/header.rs
@@ -43,10 +43,18 @@
     #[cfg(feature = "std")]
     pub fn new(size: u64) -> Header {
         let uuid = uuid::Uuid::new_v4();
+        Header::new_with_uuid(size, *uuid.as_bytes())
+    }
+
+    /// A header with the disk id supplied by the caller.
+    ///
+    /// `Header::new` needs std because `Uuid::new_v4` is getrandom; a no_std caller with its
+    /// own source of randomness can use this instead.
+    pub fn new_with_uuid(size: u64, uuid: [u8; 16]) -> Header {
         let mut header = Header {
             signature: *SIGNATURE,
             version: VERSION.into(),
-            uuid: *uuid.as_bytes(),
+            uuid,
             size: size.into(),
             ..Default::default()
         };
